# Copy this file to `.env` and adjust. Everything is optional in development.

NODE_ENV=development
PORT=3000

# REQUIRED in production: a long random string (32+ chars), e.g.  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_DAYS=7

# Day boundaries for streaks and the daily mission
APP_TIMEZONE=Asia/Kolkata

# Where the SQLite file lives (default: backend/data/placement.db)
# DB_PATH=./data/placement.db

# Only allow signups from these email domains (comma separated). Empty = anyone.
# ALLOWED_EMAIL_DOMAINS=college.edu,iitd.ac.in

# Create/promote an admin account on startup (needed for /api/admin/* endpoints)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Only if the frontend is hosted on a different origin than this server (comma separated)
# CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Set to 1 when running behind nginx / Render / Railway / Heroku (so rate limits see real IPs)
# TRUST_PROXY=1
